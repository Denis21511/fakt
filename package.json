{
  "name": "fakt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build -- --base=/fakt/ && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\" && gh-pages -d dist --add",
    "dev:gorniza": "vite --mode gorniza --port 5182",
    "build:gorniza": "tsc -b && vite build --mode gorniza --outDir dist-gorniza",
    "deploy:gorniza": "tsc -b && vite build --mode gorniza --base=/fakt/gorniza/ --outDir dist-gorniza && gh-pages -d dist-gorniza -e gorniza --add"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/manrope": "^5.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
